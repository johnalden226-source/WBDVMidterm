/* RESET & GLOBAL */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html, body {
  width: 100%;
  height: 100%;
}

body {
  font-family: Arial, sans-serif;
  font-size: 16px;
  line-height: 1.5;
  background-color: #fff7fb;
  color: #333;
}

/* UTILITIES */
.section {
  max-width: 1100px;
  margin: 0 auto;
  padding: 3rem 1.5rem;
}

.section h2 {
  text-align: center;
  margin-bottom: 2rem;
  font-size: 2rem;
  color: #b03060;
}

.section-light {
  background-color: #ffffff;
}

/* NAVBAR */
.navbar {
  background: #b03060;
  color: white;
  padding: 1rem 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 100;
}

.logo {
  font-size: 1.5rem;
  font-weight: bold;
  letter-spacing: 1px;
}

.navbar nav a {
  color: white;
  margin-left: 1rem;
  text-decoration: none;
  font-size: 0.95rem;
}

.navbar nav a:hover {
  text-decoration: underline;
}

/* HERO SECTION */
.hero {
  max-width: 1100px;
  margin: 2rem auto 0;
  padding: 2rem 1.5rem 3rem;
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 2rem;
  align-items: center;
}

.hero-text h1 {
  font-size: 2.5rem;
  margin-bottom: 1rem;
  color: #b03060;
}

.hero-text p {
  margin-bottom: 1.5rem;
  font-size: 1.05rem;
}

.btn {
  display: inline-block;
  background: #ff6699;
  color: white;
  padding: 0.75rem 1.5rem;
  border-radius: 999px;
  text-decoration: none;
  font-weight: bold;
  font-size: 0.95rem;
}

.btn:hover {
  background: #ff407f;
}

.hero-image img {
  width: 100%;
  border-radius: 16px;
  box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  object-fit: cover;
}

/* CARDS (MENU) */
.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.5rem;
}

.card {
  background: white;
  border-radius: 12px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.06);
  padding: 1rem;
  text-align: center;
}

.card img {
  width: 100%;
  height: 170px;
  object-fit: cover;
  border-radius: 10px;
  margin-bottom: 0.75rem;
}

.card h3 {
  font-size: 1.2rem;
  margin-bottom: 0.5rem;
  color: #b03060;
}

.card p {
  font-size: 0.95rem;
  margin-bottom: 0.75rem;
}

.price {
  font-weight: bold;
  color: #ff407f;
}

/* ABOUT */
.about-grid {
  display: grid;
  grid-template-columns: 1.3fr 1fr;
  gap: 2rem;
  align-items: center;
}

.about-image-wrapper img {
  width: 100%;
  border-radius: 16px;
  box-shadow: 0 10px 20px rgba(0,0,0,0.1);
}

/* CONTACT */
.contact-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.5rem;
  text-align: center;
}

.contact-grid h3 {
  color: #b03060;
  margin-bottom: 0.5rem;
}

/* FOOTER */
.footer {
  text-align: center;
  padding: 1.5rem 1rem;
  background: #b03060;
  color: white;
  margin-top: 2rem;
  font-size: 0.9rem;
}

/* RESPONSIVE */
@media (max-width: 768px) {
  .hero {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .hero-text h1 {
    font-size: 2.1rem;
  }

  .about-grid {
    grid-template-columns: 1fr;
  }
}
