/* RESET & GLOBAL */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html, body {
  width: 100%;
  height: 100%;
}

body {
  font-family: "Poppins", Arial, sans-serif;
  font-size: 16px;
  line-height: 1.6;
  background: #ffffff;
  color: #333;
}

/* TOP PINK BAR (like Caramia) */
.topbar {
  background: #d96ad1;
  color: white;
  padding: 1.1rem 2.5rem;
}

.topbar-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  font-size: 1.4rem;
  font-weight: 700;
}

.topnav a {
  color: white;
  text-decoration: none;
  margin: 0 0.8rem;
  font-size: 0.98rem;
}

.icons span {
  margin-left: 0.7rem;
}

/* PAGE HEADER (title + chips + sort) */
.page-header {
  max-width: 1100px;
  margin: 2.5rem auto 0;
  padding: 0 1.75rem;
  text-align: center;
}

.page-header h1 {
  font-size: 2.3rem;
  margin-bottom: 1.5rem;
}

.filter-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1.5rem;
  flex-wrap: wrap;
}

/* Chips */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  justify-content: center;
}

.chip {
  padding: 0.45rem 1.3rem;
  border-radius: 999px;
  border: 1px solid #d96ad1;
  background: #ffffff;
  color: #d96ad1;
  font-size: 0.85rem;
  cursor: pointer;
}

.chip-active {
  background: #d96ad1;
  color: #fff;
}

/* Sort */
.sort {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.9rem;
}

.sort select {
  padding: 0.35rem 0.9rem;
  border-radius: 999px;
  border: 1px solid #ddd;
  font-size: 0.9rem;
}

/* PRODUCT GRID */
.product-section {
  max-width: 1200px;
  margin: 2rem auto 3rem;
  padding: 0 1.75rem 3rem;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 1.75rem;
}

/* Card style similar to screenshot */
.product-card {
  background: #fce4ff;
  border-radius: 24px;
  padding: 1.3rem 1.3rem 1.5rem;
  text-align: center;
  box-shadow: 0 10px 20px rgba(0,0,0,0.05);
}

.product-img-wrapper {
  border-radius: 18px;
  overflow: hidden;
  margin-bottom: 0.9rem;
}

.product-card img {
  width: 100%;
  height: 210px;
  object-fit: cover;
}

.product-card h3 {
  font-size: 1.1rem;
  margin-bottom: 0.3rem;
  color: #5b265b;
}

.product-card p {
  font-size: 0.9rem;
  margin-bottom: 0.5rem;
}

.price {
  font-weight: 700;
  color: #c02880;
}

/* FOOTER */
.footer {
  border-top: 1px solid #eee;
  padding: 1.4rem 1rem;
  text-align: center;
  font-size: 0.85rem;
  color: #777;
}

/* RESPONSIVE */
@media (max-width: 768px) {
  .topbar {
    padding: 0.9rem 1.25rem;
  }

  .topbar-inner {
    flex-direction: row;
    gap: 0.5rem;
  }

  .filter-row {
    flex-direction: column;
    align-items: flex-start;
  }

  .page-header {
    text-align: left;
  }
}
