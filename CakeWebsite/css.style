/* RESET & GLOBAL */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html, body {
  width: 100%;
  height: 100%;
}

body {
  font-family: "Poppins", Arial, sans-serif;
  font-size: 16px;
  line-height: 1.6;
  background: linear-gradient(135deg, #fff7fb, #ffe6f0);
  color: #333;
}

/* NAVBAR */
.navbar {
  background: #b03060;
  color: white;
  padding: 1rem 1.75rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 3px 8px rgba(0,0,0,0.15);
}

.logo {
  font-size: 1.6rem;
  font-weight: 700;
  letter-spacing: 1px;
}

.navbar nav a {
  color: white;
  margin-left: 1rem;
  text-decoration: none;
  font-size: 0.95rem;
  position: relative;
}

.navbar nav a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -3px;
  width: 0;
  height: 2px;
  background: #ffd1e3;
  transition: width 0.25s ease;
}

.navbar nav a:hover::after {
  width: 100%;
}

/* HERO SECTION */
.hero {
  max-width: 1100px;
  margin: 2.5rem auto 0;
  padding: 2.5rem 1.5rem 3.5rem;
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 2.5rem;
  align-items: center;
  background: #ffffffcc;
  border-radius: 20px;
  box-shadow: 0 15px 30px rgba(0,0,0,0.08);
  backdrop-filter: blur(4px);
}

.hero-text h1 {
  font-size: 2.6rem;
  margin-bottom: 1rem;
  color: #8c274c;
}

.hero-text p {
  margin-bottom: 1.7rem;
  font-size: 1.05rem;
}

.btn {
  display: inline-block;
  background: #ff6699;
  color: white;
  padding: 0.8rem 1.7rem;
  border-radius: 999px;
  text-decoration: none;
  font-weight: 600;
  font-size: 0.95rem;
  box-shadow: 0 8px 18px rgba(255,102,153,0.4);
  transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
}

.btn:hover {
  background: #ff407f;
  transform: translateY(-1px);
  box-shadow: 0 10px 22px rgba(255,64,127,0.45);
}

.hero-image img {
  width: 100%;
  border-radius: 22px;
  box-shadow: 0 18px 30px rgba(0,0,0,0.15);
  object-fit: cover;
}

/* GENERIC SECTION */
.section {
  max-width: 1100px;
  margin: 0 auto;
  padding: 3rem 1.5rem;
}

.section h2 {
  text-align: center;
  margin-bottom: 2rem;
  font-size: 2rem;
  color: #8c274c;
}

/* MENU CARDS */
.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 1.75rem;
}

.card {
  background: white;
  border-radius: 16px;
  box-shadow: 0 10px 20px rgba(0,0,0,0.07);
  padding: 1.1rem;
  text-align: center;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.card:hover {
  transform: translateY(-4px);
  box-shadow: 0 14px 28px rgba(0,0,0,0.12);
}

.card img {
  width: 100%;
  height: 180px;
  object-fit: cover;
  border-radius: 12px;
  margin-bottom: 0.75rem;
}

.card h3 {
  font-size: 1.2rem;
  margin-bottom: 0.4rem;
  color: #b03060;
}

.card p {
  font-size: 0.95rem;
  margin-bottom: 0.7rem;
}

.price {
  font-weight: 700;
  color: #ff407f;
}

/* ABOUT */
.section-light {
  background-color: #fff;
  border-radius: 20px;
  box-shadow: 0 10px 24px rgba(0,0,0,0.06);
}

.about-grid {
  display: grid;
  grid-template-columns: 1.3fr 1fr;
  gap: 2.2rem;
  align-items: center;
}

.about-grid p {
  margin-bottom: 0.9rem;
}

.about-image-wrapper img {
  width: 100%;
  border-radius: 18px;
  box-shadow: 0 14px 26px rgba(0,0,0,0.12);
}

/* CONTACT */
.contact-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.7rem;
  text-align: center;
}

.contact-grid h3 {
  color: #b03060;
  margin-bottom: 0.4rem;
}

/* FOOTER */
.footer {
  text-align: center;
  padding: 1.6rem 1rem;
  background: #b03060;
  color: white;
  margin-top: 2.5rem;
  font-size: 0.9rem;
}

/* RESPONSIVE */
@media (max-width: 900px) {
  .hero {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .hero-text h1 {
    font-size: 2.2rem;
  }

  .about-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {
  .navbar {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .navbar nav a {
    margin-left: 0.75rem;
  }

  .hero {
    margin-top: 1.5rem;
    padding: 2rem 1.25rem 3rem;
  }

  .section {
    padding: 2.5rem 1.25rem;
  }
}
