body{
font-family: Arial, sans-serif;
margin:0;
background:#fff5f7;
}

header{
background:#7b1e3a;
color:white;
text-align:center;
padding:20px;
}

nav{
background:#f8c8dc;
text-align:center;
padding:10px;
}

nav a{
margin:15px;
text-decoration:none;
color:#7b1e3a;
font-weight:bold;
}

.hero{
text-align:center;
padding:40px;
background:#ffe4ec;
}

.cakes{
display:flex;
justify-content:center;
gap:20px;
padding:30px;
flex-wrap:wrap;
}

.cake{
background:white;
border:1px solid #ddd;
padding:15px;
width:220px;
text-align:center;
border-radius:10px;
}

.cake img{
width:100%;
border-radius:8px;
}

.order{
text-align:center;
padding:30px;
}

input, textarea{
width:250px;
padding:8px;
margin:8px;
}

button{
background:#7b1e3a;
color:white;
border:none;
padding:10px 20px;
cursor:pointer;
}

footer{
background:#7b1e3a;
color:white;
text-align:center;
padding:15px;
margin-top:20px;
}
